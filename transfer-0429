import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import {DatabaseSync} from 'node:sqlite';
import {api,notify,isOwner} from '../server/careers.js';
import worker from '../dist/server/index.js';
function database(){const raw=new DatabaseSync(':memory:');raw.exec('PRAGMA foreign_keys=ON');for(const f of fs.readdirSync('drizzle').filter(f=>f.endsWith('.sql')).sort())raw.exec(fs.readFileSync('drizzle/'+f,'utf8'));const prepare=sql=>{let values=[];return{bind(...v){values=v;return this},async first(){return raw.prepare(sql).get(...values)||null},async all(){return{results:raw.prepare(sql).all(...values)}},async run(){return{meta:{changes:Number(raw.prepare(sql).run(...values).changes)}}}}};return{raw,prepare,async batch(statements){raw.exec('BEGIN');try{const result=[];for(const s of statements)result.push(await s.run());raw.exec('COMMIT');return result}catch(e){raw.exec('ROLLBACK');throw e}}};}
const origin='https://securebydesigninc.com';
const ownerEmail='owner@example.invalid';
const fixture=()=>({submissionId:crypto.randomUUID(),name:'Example Person',email:'person@example.com',background:'Support experience',aspirations:'Security operations',storageAcknowledged:true});
function setup(){const env={DB:database(),OWNER_EMAIL:ownerEmail,SITE_ORIGIN:origin};const pending=[];const ctx={waitUntil:p=>pending.push(p)};return{env,ctx,pending};}
function request(path,method='GET',data,owner=false,extra={}){return new Request(origin+path,{method,headers:{origin,'content-type':'application/json','cf-connecting-ip':'192.0.2.1',...(owner?{'oai-authenticated-user-id':'owner-id','oai-authenticated-user-email':ownerEmail}:{}),...extra},body:data===undefined?undefined:JSON.stringify(data)});}
async function submit(s,data=fixture()){const r=await api(request('/api/career-submissions','POST',data),s.env,s.ctx);await Promise.all(s.pending);return{r,data};}
test('stores a submission and outbox record; duplicate retries do not create duplicates',async()=>{const s=setup();const {r,data}=await submit(s);assert.equal(r.status,201);assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_records').get().n,1);assert.equal(s.env.DB.raw.prepare('SELECT state FROM career_notifications').get().state,'pending');assert.equal((await submit(s,data)).r.status,200);assert.equal((await submit(s,{...data,name:'Changed'})).r.status,409);assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_records').get().n,1);});
test('owner authorization applies to every private API and requires both identity headers',async()=>{const s=setup();const {data}=await submit(s);for(const path of ['/api/career-records','/api/career-records/'+data.submissionId]){assert.equal((await api(request(path),s.env,s.ctx)).status,403);assert.equal((await api(request(path,'GET',undefined,true),s.env,s.ctx)).status,200);}assert.equal((await api(request('/api/career-notifications/retry','POST',{}),s.env,s.ctx)).status,403);assert.equal(isOwner(request('/','GET',undefined,false,{'oai-authenticated-user-email':ownerEmail}),s.env),false);assert.equal(isOwner(request('/','GET',undefined,true,{'oai-authenticated-user-email':'other@example.com'}),s.env),false);});
test('rejects missing acknowledgement, malformed email, bad date, unknown fields, and oversized bodies',async()=>{const s=setup();for(const change of [{storageAcknowledged:false},{email:'invalid'},{goal1Date:'2026-02-31'},{surprise:'field'},{background:'x'.repeat(5001)}])assert.equal((await submit(s,{...fixture(),...change})).r.status,400);assert.equal((await api(request('/api/career-submissions','POST',{...fixture(),background:'x'.repeat(65000)}),s.env,s.ctx)).status,413);assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_records').get().n,0);});
test('rejects cross-origin mutations and enforces a durable per-day submission limit',async()=>{const s=setup();assert.equal((await api(request('/api/career-submissions','POST',fixture(),false,{origin:'https://other.example'}),s.env,s.ctx)).status,403);for(let i=0;i<5;i++)assert.equal((await submit(s)).r.status,201);assert.equal((await submit(s)).r.status,429);assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_records').get().n,5);assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_notifications').get().n,5);});
test('saves follow-up and rejects stale updates without losing notes',async()=>{const s=setup();const {data}=await submit(s);const path='/api/career-records/'+data.submissionId;const payload={status:'in_progress',nextCheckIn:'2026-11-05',ownerNotes:'2026-10-05: Agreed on next action.',version:1};assert.equal((await api(request(path,'PUT',payload),s.env,s.ctx)).status,403);assert.equal((await api(request(path,'PUT',payload,true),s.env,s.ctx)).status,200);assert.equal((await api(request(path,'PUT',{...payload,ownerNotes:'Stale'},true),s.env,s.ctx)).status,409);const row=await(await api(request(path,'GET',undefined,true),s.env,s.ctx)).json();assert.equal(row.version,2);assert.equal(row.owner_notes,payload.ownerNotes);assert.equal(row.next_check_in,payload.nextCheckIn);});
test('email failure preserves the saved record; retries use the same key and no private answers',async()=>{const s=setup();const {data}=await submit(s);s.env.RESEND_API_KEY='test-only';s.env.NOTIFICATION_FROM='test@example.invalid';const old=globalThis.fetch;const calls=[];try{globalThis.fetch=async(url,options)=>{calls.push({url,...options});return calls.length===1?new Response('{}',{status:503}):Response.json({id:'receipt-1'});};assert.equal((await notify(s.env,data.submissionId)).state,'failed');assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_records').get().n,1);assert.equal((await notify(s.env,data.submissionId)).state,'accepted');assert.equal((await notify(s.env,data.submissionId)).state,'accepted');assert.equal(calls.length,2);assert.equal(calls[0].headers['Idempotency-Key'],calls[1].headers['Idempotency-Key']);const mail=JSON.parse(calls[1].body);assert.deepEqual(mail.to,['support@securebydesigninc.com']);assert.ok(!mail.text.includes(data.name));assert.ok(!mail.text.includes(data.email));assert.ok(!mail.text.includes(data.background));}finally{globalThis.fetch=old;}});
test('expired uncertain email attempts require review instead of risking duplicate delivery',async()=>{const s=setup();const {data}=await submit(s);s.env.RESEND_API_KEY='test-only';s.env.NOTIFICATION_FROM='test@example.invalid';s.env.DB.raw.prepare("UPDATE career_notifications SET state='failed',first_attempt_at=?").run(new Date(Date.now()-25*3600000).toISOString());assert.equal((await notify(s.env,data.submissionId)).state,'needs_review');});
test('record and notification insertion is atomic on database failure',async()=>{const s=setup();s.env.DB.raw.exec('DROP TABLE career_notifications');assert.equal((await submit(s)).r.status,503);assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_records').get().n,0);});
test('missing database fails clearly and never reports a saved record',async()=>{const s=setup();delete s.env.DB;assert.equal((await submit(s)).r.status,503);});
test('built site preserves the existing homepage and gates private career routes',async()=>{const s=setup();for(const path of ['/','/careers','/career.css','/career-form.js'])assert.equal((await worker.fetch(request(path),s.env,s.ctx)).status,200);assert.equal((await worker.fetch(request('/career-records'),s.env,s.ctx)).status,302);assert.equal((await worker.fetch(request('/career-records.html'),s.env,s.ctx)).status,404);assert.equal((await worker.fetch(request('/career-records','GET',undefined,true),s.env,s.ctx)).status,200);assert.equal((await worker.fetch(request('/career-records','GET',undefined,true,{'oai-authenticated-user-email':'another@example.com'}),s.env,s.ctx)).status,403);const root=await(await worker.fetch(request('/'),s.env,s.ctx)).text();assert.match(root, /Cybersecurity starts(?:<[^>]+>|\s)*with/);});
test('owner email test uses the requested inbox and reports acceptance without claiming delivery',async()=>{const s=setup();assert.equal((await api(request('/api/career-notifications/test','POST',{}),s.env,s.ctx)).status,403);assert.equal((await api(request('/api/career-notifications/test','POST',{},true),s.env,s.ctx)).status,503);s.env.RESEND_API_KEY='test-only';s.env.NOTIFICATION_FROM='sender@example.invalid';const old=globalThis.fetch;try{globalThis.fetch=async(_url,options)=>{assert.deepEqual(JSON.parse(options.body).to,['support@securebydesigninc.com']);return Response.json({id:'test-receipt'});};const r=await api(request('/api/career-notifications/test','POST',{},true),s.env,s.ctx);assert.equal(r.status,200);assert.match((await r.json()).message,/confirm receipt/);}finally{globalThis.fetch=old;}});

test('built website routes public submissions into its database and keeps records private',async()=>{const s=setup();const data=fixture();assert.equal((await worker.fetch(request('/api/career-submissions','POST',data),s.env,s.ctx)).status,201);await Promise.all(s.pending);assert.equal(s.env.DB.raw.prepare('SELECT count(*) AS n FROM career_records').get().n,1);assert.equal((await worker.fetch(request('/api/career-records'),s.env,s.ctx)).status,403);assert.equal((await worker.fetch(request('/career-records/'),s.env,s.ctx)).status,302);assert.equal((await worker.fetch(request('/career-records.html/'),s.env,s.ctx)).status,404);const form=await(await worker.fetch(request('/careers'),s.env,s.ctx)).text();assert.ok(form.includes('href="/career-goals"'));assert.ok(!form.includes('id="career-form"'));assert.ok(!form.includes('src="/career-form.js"'));assert.ok(!form.toLowerCase().includes('learning lab'));});

