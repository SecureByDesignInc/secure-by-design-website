export const policyServices=[...new Set([...trafficRules.map(r=>r.service),'RDP','SSH','Other'])];
export function evaluateFlow(from,to,service){
 if(from==='root'||to==='root')return {status:'deny',id:'AIR-GAP',purpose:'The root has no live network interface. Only local ceremonies and manual media transfers are modeled.'};
 const match=trafficRules.find(r=>r.from.includes(from)&&r.to.includes(to)&&r.service===service);
 return match||{status:'deny',id:'DEFAULT-DENY',purpose:'No explicit exception exists for this source, destination, and service.'};
}
