(()=>{
'use strict';
const root=document.getElementById('sbd-explorer');if(!root)return;
const q=s=>root.querySelector(s),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const params=new URLSearchParams(location.search),detail=q('#sbd-detail');
const normalize=s=>s.normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const excerpt=text=>text.length>185?text.slice(0,182).replace(/\s+\S*$/,'')+'…':text;
async function json(url){const r=await fetch(url);if(!r.ok)throw Error('Unable to load data');return r.json();}
function updateUrl(values){for(const [key,value] of Object.entries(values)){if(value)params.set(key,String(value));else params.delete(key);}history.replaceState(null,'',location.pathname+(params.size?'?'+params.toString():''));}
function retry(target,action){target.innerHTML='<div class="sbd-empty" role="alert"><h2>Details could not load</h2><p>Check your connection and try again.</p><button class="sbd-action" type="button" id="sbd-retry">Try again</button></div>';q('#sbd-retry').addEventListener('click',action);}
if(!detail){
 let catalog=[],category=params.get('category')||'all',page=Math.max(1,Math.floor(Number(params.get('page')))||1);const size=18,input=q('#sbd-query');input.value=params.get('q')||'';
 const allowed=[...root.querySelectorAll('[data-category]')].map(b=>b.dataset.category);if(!allowed.includes(category))category='all';
 function render(){
  const tokens=normalize(input.value.trim()).split(/\s+/).filter(Boolean);
  const results=catalog.filter(r=>(category==='all'||r.category===category)&&tokens.every(t=>r.search.includes(t)));
  const pages=Math.max(1,Math.ceil(results.length/size));page=Math.min(Math.max(1,page),pages);
  updateUrl({q:input.value.trim(),category:category==='all'?'':category,page:page>1?page:''});
  const from=(page-1)*size,query=params.size?'?'+params.toString():'';
  q('#sbd-results').innerHTML=results.slice(from,from+size).map(r=>`<a class="sbd-role" data-role="${r.code}" href="/career-explorer/roles/${r.code}${esc(query)}"><span class="sbd-role-top"><span>${esc(r.categoryLabel)}</span></span><h2>${esc(r.title)}</h2><p>${esc(excerpt(r.description))}</p><span class="sbd-role-bottom"><span>${r.pending?'Qualification update pending':'Role & qualifications'}</span><span>Explore role →</span></span></a>`).join('');
  q('#sbd-count').textContent=results.length?`${from+1}–${Math.min(from+size,results.length)} of ${results.length} roles`:'0 roles';q('#sbd-empty').hidden=results.length>0;q('#sbd-clear').hidden=!input.value;
  root.querySelectorAll('[data-category]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.category===category)));
  q('#sbd-pagination').innerHTML=pages>1?`<button class="sbd-action" id="sbd-prev" ${page===1?'disabled':''}>← Previous</button><span>Page ${page} of ${pages}</span><button class="sbd-action" id="sbd-next" ${page===pages?'disabled':''}>Next →</button>`:'';
  for(const [id,delta] of [['sbd-prev',-1],['sbd-next',1]])q('#'+id)?.addEventListener('click',()=>{page+=delta;render();q('#sbd-results a')?.focus();q('#sbd-count').scrollIntoView({block:'start',behavior:'instant'});});
 }
 async function load(){try{catalog=(await json('/career-roles/catalog.json?v=2')).map(r=>({...r,search:normalize([r.title,r.code,r.categoryLabel,r.description,...r.titles,...r.certifications,r.skillTerms].join(' '))}));render();}catch{retry(q('#sbd-pagination'),load);}}
 input.addEventListener('input',()=>{page=1;if(catalog.length)render();});q('.sbd-search').addEventListener('submit',e=>{e.preventDefault();page=1;if(catalog.length)render();});
 q('#sbd-clear').addEventListener('click',()=>{input.value='';page=1;render();input.focus();});
 q('#sbd-reset').addEventListener('click',()=>{input.value='';category='all';page=1;render();input.focus();});
 root.querySelectorAll('[data-category]').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category;page=1;render();}));load();return;
}
let role=null,section=['overview','skills','certs'].includes(params.get('view'))?params.get('view'):'overview',level=['Basic','Intermediate','Advanced'].includes(params.get('level'))?params.get('level'):'Basic',service=params.get('service')==='M'?'M':'N';
let skillType='All',designation='All',skillQuery='',skillPage=1;
const backParams=new URLSearchParams();for(const k of ['q','category','page'])if(params.has(k))backParams.set(k,params.get(k));q('#sbd-back').href='/career-explorer/roles'+(backParams.size?'?'+backParams.toString():'');
function tabs(){root.querySelectorAll('[data-section]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.section===section)));updateUrl({view:section==='overview'?'':section,level:section==='certs'&&level!=='Basic'?level:'',service:section==='certs'&&service!=='N'?service:''});}
const noCompetencies='<p class="sbd-body-copy">Detailed competencies for this role are being updated. The role description above describes its current scope.</p>';
function overview(){
 const tasks=role.competencies.filter(t=>t.type==='Task').slice(0,6);
 q('#sbd-detail-body').innerHTML=`<div class="sbd-two-columns"><div><h2>What the work includes</h2>${tasks.length?tasks.map((t,i)=>`<div class="sbd-task"><span class="sbd-number">${String(i+1).padStart(2,'0')}</span><div><p>${esc(t.text)}</p><span class="sbd-task-meta">${esc(t.designation)} responsibility</span></div></div>`).join(''):noCompetencies}${tasks.length?'<button class="sbd-action sbd-more" id="sbd-all-tasks" type="button">Explore all responsibilities →</button>':''}</div><aside class="sbd-aside"><div class="sbd-aside-label">Understand the role</div><h3>${esc(role.categoryLabel)}</h3><p>Each role describes a type of work. Employers may combine several work roles within one position.</p>${role.titles.length?'<h3 class="sbd-more">Related position titles</h3><ul class="sbd-plain-list">'+role.titles.map(t=>'<li>'+esc(t)+'</li>').join('')+'</ul>':''}<div class="sbd-context"><strong>${role.pending?'Qualification update pending':'Explore qualification options'}</strong>${role.pending?'Qualification details for this role are awaiting an update.':'See the qualifications view for certification and education options, with the scope and proficiency level clearly identified.'}</div></aside></div>`;
 q('#sbd-detail-body').insertAdjacentHTML('beforeend',`<details class="sbd-disclosure sbd-more"><summary>Detailed role description</summary><p>${esc(role.roleDefinition)}</p></details>`);
 q('#sbd-all-tasks')?.addEventListener('click',()=>{section='skills';skillType='Task';skillPage=1;render();q('[data-section="skills"]').focus();});
}
function skills(){
 if(!role.competencies.length){q('#sbd-detail-body').innerHTML='<h2>Skills & knowledge</h2>'+noCompetencies;return;}
 q('#sbd-detail-body').innerHTML=`<h2>The capabilities behind the work</h2><p class="sbd-body-copy">Core competencies are central to the role. Additional competencies depend on the assignment.</p><div class="sbd-skill-controls"><label>Competency type<select id="sbd-skill-type">${['All','Task','Knowledge','Skill','Ability'].map(t=>`<option ${t===skillType?'selected':''}>${t}</option>`).join('')}</select></label><label>Designation<select id="sbd-designation">${['All','Core','Additional'].map(t=>`<option ${t===designation?'selected':''}>${t}</option>`).join('')}</select></label><label class="sbd-skill-search">Search competencies<input type="search" id="sbd-skill-query" value="${esc(skillQuery)}" placeholder="Try network, risk, or analysis"></label></div><p id="sbd-skill-count" class="sbd-count" role="status"></p><div id="sbd-competencies"></div><div id="sbd-skill-pages" class="sbd-pagination"></div>`;
 q('#sbd-skill-type').addEventListener('change',e=>{skillType=e.target.value;skillPage=1;skillResults();});q('#sbd-designation').addEventListener('change',e=>{designation=e.target.value;skillPage=1;skillResults();});q('#sbd-skill-query').addEventListener('input',e=>{skillQuery=e.target.value;skillPage=1;skillResults();});skillResults();
}
function skillResults(){
 const results=role.competencies.filter(t=>(skillType==='All'||t.type===skillType)&&(designation==='All'||t.designation===designation)&&normalize(t.text+' '+t.id).includes(normalize(skillQuery.trim())));const pages=Math.max(1,Math.ceil(results.length/12));skillPage=Math.min(skillPage,pages);const from=(skillPage-1)*12;
 q('#sbd-skill-count').textContent=results.length?`${from+1}–${Math.min(from+12,results.length)} of ${results.length} competencies`:'No matching competencies';
 q('#sbd-competencies').innerHTML=results.slice(from,from+12).map(t=>`<article class="sbd-competency"><div><span class="sbd-pill">${esc(t.type)}</span><span class="sbd-task-meta">${esc(t.designation)}</span></div><p>${esc(t.text)}</p></article>`).join('')||'<p class="sbd-body-copy">Try another term or broaden the filters.</p>';
 q('#sbd-skill-pages').innerHTML=pages>1?`<button type="button" class="sbd-action" id="sbd-skill-prev" ${skillPage===1?'disabled':''}>← Previous</button><span>Page ${skillPage} of ${pages}</span><button type="button" class="sbd-action" id="sbd-skill-next" ${skillPage===pages?'disabled':''}>Next →</button>`:'';
 for(const [id,delta] of [['sbd-skill-prev',-1],['sbd-skill-next',1]])q('#'+id)?.addEventListener('click',()=>{skillPage+=delta;skillResults();q('#sbd-skill-type').focus();});
}
const proficiency={Basic:'Routine work with frequent, specific guidance.',Intermediate:'Non-routine work with periodic, higher-level guidance.',Advanced:'Complex work with little guidance, including guiding others.'};
const list=(heading,items)=>`<details class="sbd-disclosure"><summary>${heading}</summary>${items?.length?'<ul class="sbd-plain-list">'+items.map(x=>'<li>'+esc(x)+'</li>').join('')+'</ul>':'<p>No specific option is listed for this selection. Confirm the applicable requirements with the organization.</p>'}</details>`;
function qualifications(){
 if(role.pending||!Object.keys(role.qualifications).length){q('#sbd-detail-body').innerHTML='<h2>Qualification update pending</h2><p class="sbd-body-copy">Current qualification details for this role are awaiting an update. No certification mapping is presented until that information is available.</p><div class="sbd-context"><strong>You can still explore the work.</strong>The role description and any available competencies explain the responsibilities. Confirm position-specific requirements with the organization.</div>';return;}
 if(!role.qualifications[service])service=Object.keys(role.qualifications)[0];const data=role.qualifications[service][level];const names={N:'Navy',M:'Marine Corps'};
 const certs=data?.certifications.filter(c=>!c.retired)||[],retired=data?.certifications.filter(c=>c.retired)||[];
 q('#sbd-detail-body').innerHTML=`<div class="sbd-qual-header"><div><h2>Qualification options</h2><p>Qualification options vary by organization and role proficiency. Select a service scope below to see its options; these are not universal hiring requirements or an exam difficulty rating.</p></div><div class="sbd-qual-selects"><label class="sbd-level">Qualification scope<select id="sbd-service">${Object.keys(role.qualifications).map(s=>`<option value="${s}" ${s===service?'selected':''}>${names[s]||esc(s)}</option>`).join('')}</select></label><label class="sbd-level">Role proficiency<select id="sbd-level">${Object.keys(proficiency).map(l=>`<option ${l===level?'selected':''}>${l}</option>`).join('')}</select></label></div></div><p class="sbd-proficiency"><strong>${level}</strong> · ${proficiency[level]}</p><h3>Certifications${certs.length?' · '+certs.length:''}</h3>${certs.length?certs.map(c=>`<div class="sbd-cert-row"><div><div class="sbd-cert-name">${esc(c.name)}</div><div class="sbd-cert-note">${esc(names[service])} · ${level} proficiency</div></div>${c.acronym?'<span class="sbd-pill">'+esc(c.acronym)+'</span>':''}</div>`).join(''):'<div class="sbd-context">No current named certification is listed for this scope and proficiency level. Review the other qualification routes below.</div>'}${retired.length?list('Retired credential mappings',retired.map(c=>c.name+' — retired; not presented as a current option.')):''}<div class="sbd-context"><strong>One route to foundational qualification.</strong>A qualifying certification, education, or approved training may satisfy the foundational requirement. Higher proficiency mappings may qualify lower levels. Workplace validation and position-specific requirements still apply; you do not need every credential listed.</div><h3 class="sbd-more">Other qualification information</h3>${list('Education',data?.education)}${list('Approved training',data?.training)}${list('Workplace qualification',data?.workplace)}${list('Environment-specific requirements',data?.environment)}<details class="sbd-disclosure"><summary>Experience and continuing development</summary><p>Validated experience may be considered as an alternative under applicable program rules. Eligibility, documentation, continuing development, and any time limits must be confirmed with the organization’s workforce program manager.</p></details>`;
 q('#sbd-service').addEventListener('change',e=>{service=e.target.value;qualifications();tabs();q('#sbd-service').focus();});q('#sbd-level').addEventListener('change',e=>{level=e.target.value;qualifications();tabs();q('#sbd-level').focus();});
}
function render(){if(section==='overview')overview();else if(section==='skills')skills();else qualifications();tabs();}
root.querySelectorAll('[data-section]').forEach(b=>b.addEventListener('click',()=>{if(!role)return;section=b.dataset.section;render();}));
async function load(){try{role=await json('/career-roles/roles/'+detail.dataset.code+'.json?v=2');render();}catch{retry(q('#sbd-detail-body'),load);}}
load();
})();
