.path-dashboard-body{padding-block:72px 90px}.path-section-heading{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:34px}.path-section-heading h2{margin:0;color:#0a1d35;font-size:clamp(2.1rem,4vw,3.5rem);letter-spacing:-.055em}.path-section-heading>p{max-width:360px;margin:0;color:#5d6e82;font-size:.95rem;line-height:1.7}.path-section-heading .path-kicker{color:#1b7197}.path-module-list{border-top:1px solid #cfdae7}.path-module{display:grid;grid-template-columns:54px 52px minmax(0,1fr) 170px;gap:22px;align-items:center;min-height:170px;padding:28px 8px 28px 0;border-bottom:1px solid #cfdae7;transition:background .16s ease}.path-module:hover{background:#eef5fb}.path-module-index{align-self:stretch;display:flex;flex-direction:column;align-items:center;color:#477493;font:600 .78rem/1 var(--font-geist-mono),monospace}.path-module-index>span{display:grid;place-items:center;width:32px;height:32px;border:1px solid #a8c0d4;border-radius:50%;background:#fff}.path-module-index svg{width:16px}.path-module-index i{width:1px;flex:1;margin-top:8px;background:#bfd1df}.path-module:last-child .path-module-index i{display:none}.path-module-icon{display:grid;place-items:center;width:52px;height:52px;border-radius:12px;color:#176f99;background:#dff3f8}.path-module-icon svg{width:24px}.path-module-copy>p:first-child{margin:0 0 8px;color:#22779d;font:600 .72rem/1.4 var(--font-geist-mono),monospace;text-transform:uppercase;letter-spacing:.08em}.path-module-copy h3{margin:0 0 9px;color:#0c2138;font-size:1.45rem;line-height:1.25;letter-spacing:-.025em}.path-module-copy>p:nth-of-type(2){max-width:650px;margin:0;color:#53677c;font-size:.95rem;line-height:1.7}.path-module-copy>div{display:flex;gap:10px 20px;margin-top:14px;color:#78899b;font-size:.75rem}.path-module-copy>div span{display:flex;align-items:center;gap:6px}.path-module-copy>div svg{width:14px}.path-module-actions{display:grid;gap:10px;justify-items:stretch}.path-module-actions>a,.path-module-action