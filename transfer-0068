.prepare-page { padding-bottom: 65px; }
.prepare-opening h1 { font: 400 clamp(2.25rem, 4.3vw, 3.15rem)/1.16 var(--font-editorial); letter-spacing: -.025em; margin: 0 0 23px; }
.prepare-opening .prepare-deck { font-size: 1.2rem; line-height: 1.75; color: var(--muted-foreground); margin: 0 0 20px; }
.prepare-opening .prepare-domains { display: flex; flex-wrap: wrap; gap: 7px; font-size: .8125rem; color: var(--primary); line-height: 1.7; padding-bottom: 27px; border-bottom: 1px solid var(--border); margin: 0 0 29px; }
.prepare-story section { scroll-margin-top: 25px; }
.prepare-story section > p { color: #46566c; margin: 0 0 24px; }
.prepare-story h2 { font: 400 1.9rem/1.3 var(--font-editorial); letter-spacing: -.015em; margin: 46px 0 21px; }
.prepare-story h3 { font-size: 1.15rem; line-height: 1.5; }
.prepare-story section h3 { margin: 30px 0 15px; }
.prepare-story section a { color: var(--primary); text-decoration: underline; text-underline-offset: 4px; }
.prepare-story strong { font-weight: 600; }
.prepare-mission { margin: 28px 0; padding: 6px 0 6px 23px; border-left: 2px solid var(--cyan-line); color: #284764; }
.prepare-mission p { margin: 0; font-size: 1.1rem; line-height: 1.8; }
.prepare-boundary { background: var(--brand-surface); padding: 25px; margin: 30px 0; border: 1px solid #bed8e8; border-radius: 4px; }
.prepare-boundary figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin: 0 0 20px; line-height: 1.5; }
.prepare-boundary figcaption span { font-size: .875rem; color: #24476a; }
.prepare-boundary figcaption strong { font-size: .75rem; font-weight: 500; color: var(--muted-foreground); }
.prepare-core { text-align: center; padding: 13px 8px; border-block: 1px solid #c5d9e8; font-size: .875rem; color: #304b69; margin-bottom: 19px; }
.prepare-zones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 19px 16px; }
.prepare-zones > div { min-width: 0; padding-top: 9px; border-top: 2px solid #c9dfef; }
.prepare-zones > div > span { display: block; font: .75rem/1.6 var(--font-geist-mono), monospace; color: var(--primary); margin-bottom: 6px; }
.prepare-zones strong { display: block; font-size: .875rem; line-height: 1.55; font-weight: 500; }
.prepare-zones small { display: block; color: var(--muted-foreground); font-size: .8125rem; line-height: 1.65; margin-top: 5px; }
.prepare-boundary-bottom { display: flex; flex-wrap: wrap; gap: 8px 26px; border-top: 1px solid #c5d9e8; margin-top: 24px; padding-top: 15px; font-size: .875rem; color: #304b69; }
.prepare-boundary > p { font-size: .75rem; line-height: 1.75; color: var(--muted-foreground); margin: 17px 0 0; }
.prepare-design-notes { margin: 28px 0 35px; border-block: 1px solid var(--border); padding: 16px 0; }
.prepare-design-notes summary { cursor: pointer; font-size: .9375rem; color: var(--foreground); }
.prepare-design-notes p { font-size: .9375rem; line-height: 1.85; color: #46566c; margin: 18px 0; }
.prepare-design-notes > a { font-size: .875rem; }
.prepare-risk-notes { margin: 26px 0; }
.prepare-risk-notes > div { border-top: 1px solid var(--border); padding: 20px 0; }
.prepare-risk-notes > div:last-child { border-bottom: 1px solid var(--border); }
.prepare-risk-notes dt { font-size: 1rem; font-weight: 500; margin-bottom: 9px; }
.prepare-risk-notes dd { color: #46566c; font-size: 1rem; line-height: 1.85; margin: 0; }
.prepare-brief { border: 1px solid var(--border); margin: 27px 0; background: #fff; }
.prepare-brief header { padding: 23px 25px; background: var(--brand-surface); border-bottom: 1px solid var(--border); }
.prepare-brief header > span, .prepare-brief header > p { display: block; font-size: .8125rem; line-height: 1.6; color: var(--muted-foreground); margin: 0; }
.prepare-brief header h3 { font: 400 1.6rem/1.35 var(--font-editorial); margin: 10px 0 8px; }
.prepare-brief dl { margin: 0; padding: 0 25px; }
.prepare-brief dl > div { display: grid; grid-template-columns: 125px minmax(0, 1fr); gap: 20px; padding: 17px 0; border-bottom: 1px solid var(--border); font-size: .9375rem; line-height: 1.8; }
.prepare-brief dl > div:last-child { border-bottom: 0; }
.prepare-brief dt { font-weight: 500; }
.prepare-brief dd { color: #46566c; margin: 0; }
.prepare-brief footer { border-top: 1px solid var(--border); padding: 18px 25px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
.prepare-brief footer a { font-size: .875rem; }
.prepare-brief footer > span { font-size: .75rem; color: var(--muted-foreground); }
.prepare-conversation { margin: 43px 0 30px; padding-top: 25px; border-top: 1px solid var(--cyan-line); }
.prepare-conversation > span { font-size: .8125rem; color: var(--primary); }
.prepare-conversation > p { font: 400 1.4rem/1.55 var(--font-editorial); margin: 11px 0; }
.prepare-aside { position: sticky; top: 30px; }
.prepare-aside-note { margin-top: 28px; padding-top: 23px; border-top: 1px solid var(--border); font-size: .875rem; line-height: 1.8; }
.prepare-aside-note > span { font-weight: 500; }
.prepare-aside-note p { color: var(--muted-foreground); margin: 12px 0 18px; }
.prepare-aside-note a { color: var(--primary); }
@media (max-width: 900px) {
  .prepare-page .rmf-reading-layout { grid-template-columns: minmax(0, 1fr) 185px; gap: 30px; }
  .prepare-zones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 680px) {
  .prepare-page .rmf-reading-layout { grid-template-columns: minmax(0, 1fr); gap: 30px; padding-top: 28px; }
  .prepare-aside { position: static; }
  .prepare-boundary { padding: 19px; }
  .prepare-brief dl > div { grid-template-columns: minmax(0, 1fr); gap: 5px; }
}
@media (max-width: 380px) {
  .prepare-zones { grid-template-columns: minmax(0, 1fr); }
  .prepare-boundary { padding: 16px; }
}
@media (prefers-reduced-transparency: reduce), (forced-colors: active) {
  .prepare-boundary, .prepare-brief header { background: var(--background); }
}
@media print {
  .prepare-aside, .prepare-opening .back-link, .prepare-story .rmf-next { display: none; }
  .prepare-page .rmf-reading-layout { display: block; }
  .prepare-boundary, .prepare-brief { break-inside: avoid; }
}
