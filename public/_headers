# Browser protections for static files (Cloudflare Workers Static Assets). Pages the Worker renders get the
# same headers from server/index.js; this file only reaches files served straight from public/.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()

# Course 1.1, Build and harden the identity foundation (scripts/prepare-course-guides.mjs; courses 1.1–1.8 merged, 20 October 2026).
