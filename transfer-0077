/* Shared blue/cyan template shell; article and form surfaces stay light for reading. */
body.site-editorial .footer-actions{display:flex;align-items:flex-start;flex-wrap:wrap;gap:14px 20px;max-width:100%}
body.site-editorial .footer-actions>a{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:#dcecff}
.footer-share-host{max-width:100%}
.footer-share{position:relative;max-width:280px;color:#cae5f0}
.footer-share-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 15px;border:1px solid #47798e;border-radius:9px;background:linear-gradient(135deg,#12394e,#102a3b);color:#c5f3fa;font:inherit;font-size:13px;font-weight:650;cursor:pointer;white-space:nowrap}
.footer-share-button:hover{border-color:#8cddeb;background:#19465d;color:#fff}
.footer-share-button:disabled{opacity:.65;cursor:wait}
.footer-share :is(button,input):focus-visible{outline:3px solid #82dfef;outline-offset:3px}
.footer-share-status{display:block;max-width:240px;margin-top:8px;color:#cae5f0;font-size:12px;line-height:1.6}
.footer-share-status:empty{position:absolute;width:1px;height:1px;margin:0;overflow:hidden;clip-path:inset(50%)}
.footer-share-manual{margin-top:12px;max-width:100%;width:260px}
.footer-share-manual[hidden]{display:none}
.footer-share-manual label{display:block;margin-bottom:6px;font-size:12px;line-height:1.5}
.footer-share-manual input{box-sizing:border-box;width:100%;min-width:0;min-height:44px;margin-bottom:10px;padding:9px;border:1px solid #719ead;border-radius:7px;background:#f5fbfd;color:#17394d;font:inherit;font-size:12px}
@media(max-width:620px){body.site-editorial .footer-actions{flex-basis:100%;justify-content:space-between}.footer-share{max-width:100%}}
@media(forced-colors:active){.footer-share-button{background:ButtonFace;color:ButtonText;border-color:ButtonText}.footer-share-status{color:CanvasText}}
body.site-editorial .site-header .site-header-identity{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1.6fr);align-items:center;gap:24px}
body.site-editorial .site-header .brand{justify-self:start;align-self:center;flex-direction:row;justify-content:flex-start;text-align:left;gap:18px;min-width:0;max-width:100%}
body.site-editorial .site-header .brand-logo{width:128px;height:128px;object-fit:contain;flex:none;border-radius:12px}
body.site-editorial .site-header .brand-wordmark{min-width:0;line-height:1.15}
body.site-editorial .site-header .brand-wordmark>span{display:block}
body.site-editorial{--primary:#1269b9;--ring:#147bad;--border:#c2d9e8;--font-editorial:var(--font-geist-sans),Arial,sans-serif;background:#f8fbff}
body.site-editorial .site-header.container{width:100%;max-width:none;display:flex;flex-direction:column;gap:20px;align-items:stretch;padding:20px max(24px,calc((100% - 1180px)/2)) 17px;background:#050b14;border-bottom:1px solid #29405a;color:#f3f7ff;box-shadow:none}
body.site-editorial .site-header .brand{color:#f3f7ff;font-size:2.25rem;letter-spacing:-.05em}.site-header .brand-logo{border-radius:50%}body.site-editorial .site-header .brand small{color:#a4b9d1;font-size:.75rem;letter-spacing:.025em;max-width:300px}
body.site-editorial .site-header nav{border:1px solid #2a405b;border-radius:12px;background:#0c1828;gap:7px;justify-content:center;padding:5px;margin:0}body.site-editorial .site-header nav .nav-link{font-size:.875rem;color:#b4c7df;border-radius:8px;padding:10px 20px;background:transparent;border:1px solid transparent;box-shadow:none}body.site-editorial .site-header nav .nav-link:hover{background:#152b45;border-color:#2c5077;color:#eff8ff}body.site-editorial .site-header nav .nav-link[aria-current=page]{background:linear-gradient(115deg,#174675,#102a47);border-color:#4386b9;color:white;box-shadow:none}
body.site-editorial .site-footer.container{width:100%;max-width:none;padding:30px max(24px,calc((100% - 1180px)/2));background:#050b14;color:#a4b8d1;border-top:1px solid #29405a}body.site-editorial .site-footer .footer-brand,body.site-editorial .site-footer>a:last-child{color:#dcecff}body.site-editorial .site-footer .footer-brand span{color:#93abc7}
body.site-editorial :is(.article-header,.rmf-hero,.learning-hero,.range-intro,.career-intro){background:radial-gradient(ellipse at 95% 85%,#106fa14d,transparent 70%),#08192b;border-color:#285479}
body.site-editorial .article-header{box-shadow:0 15px 35px #092d4910}body.site-editorial .article-body{color:#2b455d}body.site-editorial .article-body h2{color:#0b2e4e}body.site-editorial .article-contents{border-color:#b3d5e8;background:#eef7fc}
body.site-editorial .career-intro{padding:30px;border:1px solid #285479;border-radius:18px;color:white;margin-bottom:28px}body.site-editorial .career-intro h1{color:white}body.site-editorial .career-intro :is(p,.eyebrow){color:#c3d9ed}body.site-editorial .career-tabs{border-color:#bdd4e8}body.site-editorial .career-tabs [aria-selected=true]{background:linear-gradient(115deg,#176bb7,#145276);color:white;border-color:#2b87bb}body.site-editorial .career-hub button[type=submit]{background:linear-gradient(115deg,#176bb7,#145276);border-color:#2b87bb;color:white;border-radius:10px}body.site-editorial .career-hub :is(input,textarea,select):focus-visible{outline:3px solid #249bc7;outline-offset:2px}
@media(max-width:800px){body.site-editorial .site-header nav{flex-wrap:wrap}body.site-editorial .site-header nav .nav-link{padding-inline:13px}body.site-editorial .site-header .brand{font-size:1.5rem}}
@media(max-width:620px){body.site-editorial .site-header.container{padding:18px;gap:17px}body.site-editorial .site-header nav{justify-content:flex-start;gap:3px}body.site-editorial .site-header nav .nav-link{font-size:.8125rem;padding:10px 12px}body.site-editorial .site-footer.container{padding:26px 18px}body.site-editorial .career-intro{padding:24px}}
@media print,(forced-colors:active){body.site-editorial .site-header.container,body.site-editorial .site-footer.container{background:Canvas;color:CanvasText}body.site-editorial .site-header .brand,body.site-editorial .footer-partner-name{color:CanvasText}}

@media(max-width:1000px){body.site-editorial .site-header .site-header-identity{grid-template-columns:minmax(0,1fr);gap:18px}body.site-editorial .site-header .brand{grid-column:1 / -1}body.site-editorial .site-header .header-socials{grid-column:1 / -1}}

body.site-editorial .site-header nav.header-socials{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-width:0;width:100%;padding:0;border:0;border-radius:0;background:transparent;font-size:.875rem}
body.site-editorial .header-socials>span,body.site-editorial .app-store-heading>strong{font-family:var(--font-geist-sans),Arial,sans-serif;font-size:14px;font-weight:700;line-height:1.5;color:#f3f7ff}
body.site-editorial .header-socials>div{display:flex;flex-wrap:wrap;justify-content:center;gap:6px}
body.site-editorial .header-socials a{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:5px 8px;border:1px solid #355b7c;border-radius:12px;background:linear-gradient(115deg,#12314e,#0c1d31);color:#e5f3ff;text-decoration:none;font-weight:600;box-shadow:inset 0 1px 0 #a6e8ff0a;transition:background .16s,border-color .16s,transform .16s,box-shadow .16s}
body.site-editorial .header-socials a:hover{background:linear-gradient(115deg,#174675,#102a47);border-color:#77cce6;color:#fff;transform:translateY(-2px);box-shadow:0 4px 16px #42c7ee18}
body.site-editorial .header-socials a:active{transform:translateY(0)}
body.site-editorial .header-socials a:focus-visible{outline:2px solid #8ed5e6;outline-offset:4px}
body.site-editorial .header-social-icon{display:block;width:16px;height:16px;flex:none;object-fit:contain}
body.site-editorial .header-connect{display:grid;gap:14px;min-width:0}
body.site-editorial .header-app-stores{min-width:0;text-align:center}
body.site-editorial .header-connect nav.header-socials{border-top:1px solid #29405a;padding-top:12px}
body.site-editorial .app-store-heading{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px 14px;margin-bottom:8px;font-size:16px;color:#f3f7ff}
body.site-editorial .app-store-heading span{color:#8ed5e6;font-size:14px}
body.site-editorial .request-access-link{color:#8ed5e6;font-size:14px;text-decoration:underline;text-underline-offset:4px;font-weight:600}
body.site-editorial .request-access-link:hover{color:#c7f3ff}
body.site-editorial .request-access-link:focus-visible{outline:2px solid #8ed5e6;outline-offset:4px}
body.site-editorial .app-store-badges{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:8px 20px;width:min(100%,320px);margin-inline:auto}
body.site-editorial .app-store-item{min-width:0;display:flex;flex-direction:column;align-items:center;gap:2px}
body.site-editorial .app-store-item>span{color:#b4c7df;font-size:12px}
body.site-editorial .app-store-badge{display:flex;align-items:center;justify-content:center;height:48px;min-width:96px;margin:0;padding:8px 0;border:0;border-radius:0;background:transparent;box-shadow:none;text-decoration:none;transform:none}
body.site-editorial .app-store-badge:disabled{cursor:not-allowed;opacity:1;background:transparent;color:inherit;box-shadow:none}
body.site-editorial .app-store-badge img{display:block;width:auto;height:32px;max-width:100%;object-fit:contain}
body.site-editorial .app-store-google-play .app-store-badge{padding:0;min-width:0;margin-inline:0}
body.site-editorial .app-store-google-play .app-store-badge img{height:48px}
body.site-editorial a.app-store-badge:focus-visible{outline:2px solid #8ed5e6;outline-offset:4px;border-radius:6px}
@media(max-width:620px){body.site-editorial .app-store-badges{gap:10px 14px}body.site-editorial .app-store-heading{flex-direction:column;gap:4px}}
@media(max-width:620px){body.site-editorial .site-header .brand{gap:12px;font-size:clamp(1.25rem,5.5vw,1.5rem)}body.site-editorial .site-header .brand-logo{width:88px;height:88px}body.site-editorial .site-header .brand small{font-size:.75rem;line-height:1.5;margin-top:5px}}


@media(prefers-reduced-motion:reduce){body.site-editorial .header-socials a{transition:none}body.site-editorial .header-socials a:hover{transform:none}}
@media(forced-colors:active){body.site-editorial .header-social-icon{filter:none}body.site-editorial .header-socials a{color:LinkText}}

body.site-editorial .footer-partners{display:flex;flex-wrap:wrap;align-items:center;gap:20px;max-width:100%}
body.site-editorial .footer-partner{display:flex;flex-wrap:wrap;align-items:center;gap:10px;min-width:0}
body.site-editorial .footer-partner-logo{display:block;flex:none;width:108px;height:40px;padding:6px 8px;border-radius:5px;background:#f8fcff;color-scheme:light}
body.site-editorial .footer-partner-logo img{display:block;width:100%;height:100%;object-fit:contain}
body.site-editorial .footer-partner-name{color:#d1e1f2;font-size:.875rem;font-weight:600;line-height:1.4}
@media(max-width:620px){body.site-editorial .footer-partners{flex-basis:100%;gap:16px}}
@media(forced-colors:active){body.site-editorial .footer-partner-name{color:CanvasText}body.site-editorial .footer-partner-logo{forced-color-adjust:none;background:#fff}}

body.site-editorial .app-store-item .app-store-availability{display:block;color:#a8e5f4;font-size:11px;line-height:1.5;text-align:center;max-width:150px;margin-top:3px}
