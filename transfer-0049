.reader-page{padding-block:44px 70px;color:#173b56}.reader-heading h1{font-size:clamp(2rem,5vw,3.2rem);letter-spacing:-.04em;margin:10px 0}.reader-heading>p:last-child{font-size:1.1rem;color:#49677e}.reader-welcome,.reader-privacy{padding:30px;border:1px solid #bfd6e6;border-radius:16px;background:#eef7fc;margin-top:28px}.reader-welcome{max-width:760px}.reader-welcome h2,.reader-privacy h2{font-size:1.5rem;margin-bottom:12px}.reader-welcome p{margin:16px 0;line-height:1.7}.reader-primary{display:inline-block;background:#1269a8;color:white!important;padding:12px 20px;border-radius:9px}.reader-note{font-size:.875rem;color:#526b7f}.reader-account{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;margin:24px 0;font-size:.875rem;overflow-wrap:anywhere}.reader-summary{display:grid;grid-template-columns:1fr 1fr 2fr;gap:20px}.reader-summary section{border:1px solid #bad5e5;border-radius:14px;background:#eff8fc;padding:24px}.reader-summary strong{display:block;font-size:2.7rem}.reader-summary h2{font-size:1.25rem;margin:12px 0}.reader-summary p,.reader-summary span{font-size:.875rem;color:#49677e}.reader-collection{margin-top:36px}.reader-collection-heading{display:flex;justify-content:space-between;align-items:center;gap:16px}.reader-collection h2{font-size:1.5rem}.reader-collection-heading span{font-size:.875rem;color:#49677e}.reader-collection progress{display:block;width:100%;height:9px;accent-color:#087cae;margin:15px 0}.reader-collection ul{list-style:none;padding:0;border:1px solid #c2d9e8;border-radius:12px;overflow:hidden;background:white}.reader-collection li{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:19px 22px;border-bottom:1px solid #d9e7ef}.reader-collection li:last-child{border:0}.reader-collection li span{display:block;font-size:.875rem;color:#627487;margin-top:4px}.reader-collection li a{font-weight:600}.reader-page button,.reader-save button,.reader-path-account button{padding:9px 13px;border:1px solid #8a