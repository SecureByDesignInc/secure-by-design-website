@media(max-width:700px){.reader-summary{grid-template-columns:1fr 1fr}.reader-summary section:last-child{grid-column:1/-1}.reader-save,.reader-collection li{align-items:flex-start;flex-direction:column}.reader-collection-heading{align-items:flex-start;flex-direction:column;gap:5px}.reader-welcome,.reader-privacy{padding:22px}.reader-path-account{margin:18px}.reader-page{padding-top:28px}}

