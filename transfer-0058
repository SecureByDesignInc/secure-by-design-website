.rmf-compliance { scroll-margin-top:24px; }
.rmf-compliance-links { display:grid; gap:10px; list-style:none; margin:0 0 24px; padding:0; }
.rmf-compliance-links li { min-width:0; }
.rmf-compliance-links a { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:68px; padding:13px 14px; background:#fff; border:1px solid #9dbbdf; border-left:3px solid #2c5fbb; border-radius:4px; color:#174c9c; text-decoration:none; }
.rmf-compliance-links a > span:first-child { min-width:0; }
.rmf-compliance-links strong { display:block; font-size:1rem; font-weight:650; line-height:1.5; text-decoration:underline; text-underline-offset:3px; }
.rmf-compliance-links small { display:block; margin-top:5px; font-size:.8125rem; line-height:1.6; color:#465d77; }
.rmf-compliance-arrow { flex:none; font-size:1.25rem; }
.rmf-compliance-links a:hover { background:#eaf2ff; border-color:#2c5fbb; }
.rmf-compliance-links a:focus-visible { outline:3px solid #174c9c; outline-offset:3px; }
.rmf-compliance > p + p { margin-top:14px; }
.rmf-framework-links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0 2rem; list-style:none; margin:0; padding:0; }
.rmf-framework-links li { padding:1.25rem 0; border-top:1px solid var(--border); }
.rmf-framework-links a { display:inline-block; color:var(--primary); font-size:1rem; font-weight:600; line-height:1.65; text-decoration:underline; text-underline-offset:3px; overflow-wrap:anywhere; }
.rmf-framework-links p { margin:.5rem 0 0; color:var(--muted-foreground); font-size:1rem; line-height:1.75; }
@media(max-width:900px) { .rmf-framework-links { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:620px) {
  .rmf-framework-links { grid-template-columns:1fr; }
}
@media(forced-colors:active) {
  .rmf-compliance-links a { border-color:LinkText; color:LinkText; }
  .rmf-compliance-links small { color:CanvasText; }
  .rmf-framework-links a { color:LinkText; }
  .rmf-framework-links p { color:CanvasText; }
}
