.evidence-intro { padding: 2.5rem 0 1.5rem; max-width: 54rem; }
.evidence-intro h1 { margin: 0 0 1rem; font-family: var(--font-editorial); font-weight: 400; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; letter-spacing: -.025em; }
.evidence-intro > p { font-size: 1.125rem; line-height: 1.8; color: var(--muted-foreground); margin: 0; }
.evidence-guide strong { font-weight: 600; }
.evidence-content > section > p a { color: var(--primary); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--cyan-line); }
.evidence-layout { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 3.5rem; align-items: start; }
.evidence-jump { position: sticky; top: 1.5rem; display: flex; flex-direction: column; gap: .4rem; border-top: 1px solid var(--border); padding-top: 1.25rem; }
.evidence-jump > p { font-size: .875rem; color: var(--muted-foreground); margin: 0 0 .75rem; }
.evidence-jump > a { display: flex; justify-content: space-between; gap: .75rem; padding: .45rem 0; font-size: .9375rem; line-height: 1.6; }
.evidence-jump > a > span { color: var(--muted-foreground); font-size: .875rem; }
.evidence-jump > .evidence-jump-extra { border-top: 1px solid var(--border); padding-top: 1rem; margin-top: .6rem; }
.evidence-content { min-width: 0; }
.evidence-phase, .evidence-package, .evidence-maintenance { border-top: 1px solid var(--border); padding: 1.75rem 0 2.75rem; scroll-margin-top: 1.5rem; }
.evidence-phase-label { color: var(--primary); font-size: .875rem; line-height: 1.65; margin: 0 0 .75rem; }
.evidence-guide h2 { font-family: var(--font-editorial); font-weight: 400; font-size: 2rem; line-height: 1.3; margin: 0 0 1rem; letter-spacing: -.02em; }
.evidence-guide h3 { font-size: 1rem; line-height: 1.6; margin: 0 0 .7rem; font-weight: 600; }
.evidence-purpose { font-size: 1.125rem; color: var(--muted-foreground); line-height: 1.8; margin: 0 0 1.5rem; }
.evidence-phase-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
.evidence-phase-details p, .evidence-phase-details li, .evidence-package > p, .evidence-package dd, .evidence-maintenance p, .evidence-maintenance li { font-size: 1rem; line-height: 1.85; color: #46566c; }
.evidence-phase-details p { margin: 0 0 1.25rem; }
.evidence-phase-details ul { list-style: disc; padding-left: 1.25rem; margin: 0; }
.evidence-phase-details li { padding: 0 0 .7rem .15rem; }
.evidence-application { margin: .5rem 0 1.25rem; padding: 1rem 1.25rem; background: var(--brand-surface); border-left: 2px solid var(--cyan-line); font-size: 1rem; line-height: 1.8; color: var(--muted-foreground); }
.evidence-application strong { display: block; color: var(--foreground); margin-bottom: .35rem; font-size: .875rem; }
.evidence-phase-links { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem 1.25rem; font-size: .875rem; line-height: 1.7; color: var(--primary); }
.evidence-phase-links > span { color:var(--muted-foreground); }
.evidence-package > p, .evidence-maintenance > p { margin: 0 0 1.5rem; }
.evidence-package-records { margin: 1.75rem 0; border-block: 1px solid var(--border); }
.evidence-package-records > div { padding: 1.25rem 0; border-bottom: 1px solid var(--border); }
.evidence-package-records > div:last-child { border-bottom: 0; }
.evidence-package dt { font-size: 1.0625rem; line-height: 1.5; font-weight: 600; margin-bottom: .5rem; }
.evidence-package dd { margin: 0; }
.evidence-maintenance ol { list-style: decimal; padding-left: 1.35rem; margin: 0; }
.evidence-maintenance li { padding: 0 0 1rem .3rem; }
@media (max-width: 950px) { .evidence-layout { grid-template-columns: 10rem minmax(0, 1fr); gap: 2rem; } .evidence-phase-details { grid-template-columns: 1fr; gap: 1rem; } }
@media (max-width: 680px) {
  .evidence-intro { padding-top: 2rem; }
  .evidence-layout { grid-template-columns: 1fr; gap: 1.5rem; }
  .evidence-jump { position: static; flex-direction: row; flex-wrap: wrap; gap: .35rem 1.25rem; }
  .evidence-jump > p { flex-basis: 100%; margin: 0; }
  .evidence-jump > a { padding: .35rem 0; }
  .evidence-jump > a > span { display: none; }
  .evidence-jump > .evidence-jump-extra { border: 0; padding: .35rem 0; margin: 0; }
  .evidence-guide h2 { font-size: 1.75rem; }
  .evidence-phase, .evidence-package, .evidence-maintenance { padding-bottom: 2rem; }
}
@media (prefers-reduced-transparency: reduce), (forced-colors: active), print { .evidence-application { background: var(--reading-tint); } }
@media print { .evidence-jump { display: none; } .evidence-layout { display: block; } }
