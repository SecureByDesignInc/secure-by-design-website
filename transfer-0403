"""Build classic-script sharing for standalone/offline guides and refresh the ZIP."""
from pathlib import Path
import hashlib
import json
import re
import zipfile

root = Path(__file__).resolve().parent.parent
public = root / 'public'
training = public / 'training'
package = training / 'dc01-dc02'
shared = (public / 'footer-share.mjs').read_text()
# Classic scripts work when the downloaded guide is opened directly from disk.
script = ('// Generated by scripts/prepare-training-sharing.py from footer-share.mjs.\n'
          '(function () {\n' + re.sub(r'^export ', '', shared, flags=re.MULTILINE) + '\n'
          "document.querySelectorAll('[data-learning-share]').forEach(root => {\n"
          "  const message = document.createElement('p');\n"
          "  message.textContent = learningShareNote;\n"
          "  root.innerHTML = renderFooterShare();\n"
          "  root.prepend(message);\n"
          "  mountFooterShare(root, navigator);\n"
          "});\n})();\n")
(training / 'guide-share.js').write_text(script)
(package / 'guide-share.js').write_text(script)
(package / 'guide-share.css').write_bytes((training / 'guide-share.css').read_bytes())

manifest_path = package / 'package-manifest.json'
manifest = json.loads(manifest_path.read_text())
names = list(dict.fromkeys([entry['name'] for entry in manifest['files']] + ['guide-share.js', 'guide-share.css']))
manifest['files'] = []
for name in names:
    data = (package / name).read_bytes()
    manifest['files'].append({'name': name, 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()})
manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + '\n')
with zipfile.ZipFile(package / 'SecureByDesign-DC01-DC02-Learning-Package.zip', 'w', zipfile.ZIP_DEFLATED) as archive:
    for name in names + ['package-manifest.json']:
        archive.write(package / name, name)
print('Prepared standalone sharing and refreshed the learning-package manifest and ZIP.')
