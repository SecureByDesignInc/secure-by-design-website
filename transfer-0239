.career-explorer-content {
  --ink: #101828;
  --navy: #101d2f;
  --navy-2: #17273d;
  --paper: #f7f9f6;
  --white: #fff;
  --line: #dce2df;
  --muted: #667085;
  --green: #a2edf5;
  --purple: #b9d7ff;
  --green-deep: #1269b9;
}
.career-explorer-content * { box-sizing: border-box; }
.career-explorer-content a { color: inherit; text-decoration: none; }
.career-explorer-content button { font: inherit; }
.career-explorer-content .journey-section { padding: 96px clamp(24px, 6vw, 96px) 110px; }
.career-explorer-content .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 42px; }
.career-explorer-content .section-heading > div { display: flex; align-items: baseline; gap: 20px; }
.career-explorer-content .section-number, .career-explorer-content .mini-label { color: var(--green-deep); font-size: .75rem; letter-spacing: .15em; font-weight: 900; }
.career-explorer-content .section-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.045em; line-height: 1.05; }
.career-explorer-content .section-heading p { max-width: 340px; margin: 0; color: var(--muted); }
.career-explorer-content .direction-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 900px; margin-bottom: 38px; }
.career-explorer-content .direction-tab { border: 1px solid var(--line); background: white; color: var(--ink); border-radius: 9px; padding: 18px 20px; display: grid; grid-template-columns: auto 1fr; column-gap: 14px; text-align: left; cursor: pointer; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
.career-explorer-content .direction-tab:hover { border-color: #b7c2bc; transform: translateY(-2px); }
.career-explorer-content .direction-tab > span { grid-row: 1 / 3; align-self: center; color: var(--green-deep); font-size: .62rem; letter-spacing: .13em; font-weight: 900; }
.career-explorer-content .direction-tab b { font-size: .95rem; }
.career-explorer-content .direction-tab small { color: var(--muted); font-size: .73rem; }
.career-explorer-content .direction-tab.active { background: var(--navy); color: white; border-color: var(--navy); box-shadow: 0 12px 28px rgba(16,29,47,.12); }
.career-explorer-content .direction-tab.active > span { color: var(--green); }
.career-explorer-content .direction-tab.active small { color: #aebbc9; }
.career-explorer-content .direction-view[hidden] { display: none; }
.career-explorer-content .direction-view { animation: direction-in .22s ease; }
.career-explorer-content .view-heading { display: grid; grid-template-columns: minmax(170px, .4fr) minmax(0, 1fr); gap: 30px; align-items: start; margin-bottom: 25px; padding-top: 26px; border-top: 1px solid var(--line); }
.career-explorer-content .view-heading > span { color: var(--green-deep); font-size: .65rem; letter-spacing: .14em; font-weight: 900; padding-top: 8px; }
.career-explorer-content .view-heading h3 { margin: 0 0 7px; font-size: clamp(1.5rem, 3vw, 2.35rem); line-height: 1.08; letter-spacing: -.035em; }
.career-explorer-content .view-heading p { margin: 0; color: var(--muted); max-width: 720px; font-size: .88rem; }
@keyframes direction-in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
.career-explorer-content .journey-layout { display: grid; grid-template-columns: minmax(330px, .84fr) minmax(480px, 1.3fr); gap: 20px; }
.career-explorer-content .stage-list { display: flex; flex-direction: column; gap: 8px; }
.career-explorer-content .stage { width: 100%; border: 1px solid var(--line); background: transparent; border-radius: 8px; padding: 16px; display: grid; grid-template-columns: 34px 1fr 25px; gap: 10px; text-align: left; color: var(--ink); cursor: pointer; transition: all .18s ease; align-items: center; }
.career-explorer-content .stage:hover { background: white; border-color: #c4cdc8; transform: translateX(3px); }
.career-explorer-content .stage.active { background: var(--navy); color: white; border-color: var(--navy); box-shadow: 0 14px 32px rgba(16,29,47,.16); }
.career-explorer-content .stage-index { font-size: .72rem; color: #82908a; font-weight: 800; }
.career-explorer-content .stage.active .stage-index, .career-explorer-content .stage.active .stage-arrow { color: var(--green); }
.career-explorer-content .stage b, .career-explorer-content .stage small { display: block; }
.career-explorer-content .stage b { font-size: .95rem; }
.career-explorer-content .stage small { margin-top: 2px; color: #7a8795; font-size: .78rem; line-height: 1.35; }
.career-explorer-content .stage.active small { color: #afbac8; }
.career-explorer-content .stage-arrow { justify-self: end; }
.career-explorer-content .stage-panel { background: white; border: 1px solid var(--line); border-radius: 11px; padding: clamp(28px, 4vw, 50px); min-height: 760px; outline: none; box-shadow: 0 20px 55px rgba(16,24,40,.055); }
.career-explorer-content .panel-kicker { display: inline-block; background: #eaf6fb; color: #1269b9; border-radius: 999px; padding: 5px 10px; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 900; }
.career-explorer-content .stage-panel h3 { font-size: clamp(1.7rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -.035em; max-width: 660px; margin: 20px 0 12px; }
.career-explorer-content .panel-summary { color: var(--muted); max-width: 720px; margin-bottom: 24px; }
.career-explorer-content .stage-meta { display: grid; grid-template-columns: 155px 1fr; gap: 24px; border-top: 1px solid var(--line); padding-top: 20px; }
.career-explorer-content .stage-meta span { display: flex; flex-direction: column; gap: 3px; }
.career-explorer-content .stage-meta small { color: #89958f; font-size: .64rem; font-weight: 850; letter-spacing: .12em; }
.career-explorer-content .stage-meta b { font-size: .84rem; }
.career-explorer-content .depth-tabs { margin-top: 30px; display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); }
.career-explorer-content .depth-tab { border: 0; border-bottom: 3px solid transparent; background: transparent; padding: 12px 8px; color: #6b7785; font-size: .76rem; font-weight: 800; cursor: pointer; }
.career-explorer-content .depth-tab:hover { color: var(--ink); }
.career-explorer-content .depth-tab.active { border-color: var(--green-deep); color: var(--ink); }
.career-explorer-content .depth-view { min-height: 300px; padding-top: 28px; }
.career-explorer-content .questions-view { display: grid; grid-template-columns: 1.25fr .75fr; gap: 28px; }
.career-explorer-content .question-list { margin: 14px 0 0; padding: 0; list-style: none; display: grid; gap: 12px; }
.career-explorer-content .question-list li { display: grid; grid-template-columns: 18px 1fr; gap: 9px; color: #475467; font-size: .86rem; line-height: 1.4; }
.career-explorer-content .question-list li::before { content: "?"; color: var(--green-deep); font-weight: 900; }
.career-explorer-content .watchout-card { background: #f3f0ff; padding: 22px; border-radius: 8px; border-left: 3px solid var(--purple); }
.career-explorer-content .watchout-card h4 { margin: 10px 0 8px; line-height: 1.25; }
.career-explorer-content .watchout-card p { margin: 0; color: var(--muted); font-size: .83rem; }
.career-explorer-content .plan-header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
.career-explorer-content .plan-header h4, .career-explorer-content .ready-view h4 { margin: 7px 0 0; font-size: 1rem; }
.career-explorer-content .plan-header > span { color: var(--muted); font-size: .75rem; }
.career-explorer-content .action-plan { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
.career-explorer-content .action-plan li { display: grid; grid-template-columns: 64px 1fr; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
.career-explorer-content .action-plan li > span { color: var(--green-deep); font-size: .67rem; font-weight: 900; letter-spacing: .08em; }
.career-explorer-content .action-plan b { display: block; font-size: .88rem; }
.career-explorer-content .action-plan p { margin: 2px 0 0; color: var(--muted); font-size: .8rem; line-height: 1.4; }
.career-explorer-content .practice-view { display: grid; gap: 18px; }
.career-explorer-content .scenario { background: var(--navy); color: white; padding: 24px; border-radius: 8px; }
.career-explorer-content .scenario .mini-label { color: var(--green); }
.career-explorer-content .scenario h4 { margin: 10px 0 6px; font-size: 1.25rem; }
.career-explorer-content .scenario p { color: #bbc6d1; margin: 0; font-size: .88rem; }
.career-explorer-content .evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.career-explorer-content .evidence-grid > div { border: 1px solid var(--line); border-radius: 7px; padding: 18px; }
.career-explorer-content .evidence-grid span { font-size: .64rem; letter-spacing: .12em; color: var(--green-deep); font-weight: 900; }
.career-explorer-content .evidence-grid p { margin: 7px 0 0; color: var(--muted); font-size: .81rem; }
.career-explorer-content .readiness-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
.career-explorer-content .readiness-score { display: flex; align-items: baseline; gap: 5px; color: var(--muted); }
.career-explorer-content .readiness-score strong { font-size: 2rem; color: var(--green-deep); line-height: 1; }
.career-explorer-content .readiness-score span { font-size: .72rem; }
.career-explorer-content .check-list { display: grid; gap: 8px; margin-top: 20px; }
.career-explorer-content .check-list label { display: flex; gap: 12px; align-items: start; padding: 11px 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 7px; cursor: pointer; color: #475467; font-size: .83rem; }
.career-explorer-content .check-list label:has(input:checked) { background: #eaf6fb; color: var(--ink); border-color: #b9dce8; }
.career-explorer-content .check-list input { margin-top: 3px; accent-color: var(--green-deep); }
.career-explorer-content .readiness-note { font-size: .76rem; color: var(--muted); margin: 15px 0 0; }
.career-explorer-content .resource-strip { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
.career-explorer-content .resource-strip > span { text-transform: uppercase; letter-spacing: .13em; font-size: .68rem; font-weight: 900; color: #84908a; }
.career-explorer-content .resource-strip > div { display: flex; flex-wrap: wrap; gap: 8px; }
.career-explorer-content .resource-strip a { background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; font-size: .75rem; font-weight: 700; }
.career-explorer-content .resource-strip a:hover { background: #eaf6fb; border-color: #add9e5; }
.career-explorer-content .market-section { padding: 100px clamp(24px, 6vw, 96px) 110px; background: #e9eeeb; border-top: 1px solid #d4dcd7; }
.career-explorer-content .market-heading { margin-bottom: 34px; }
.career-explorer-content .market-heading h2 { max-width: 790px; }
.career-explorer-content .market-controls { background: var(--navy); color: white; padding: 20px; display: grid; grid-template-columns: .8fr 1.2fr auto; gap: 14px; align-items: end; border-radius: 10px 10px 0 0; }
.career-explorer-content .market-controls label { display: grid; gap: 7px; }
.career-explorer-content .market-controls label > span { color: #91a0b0; font-size: .64rem; letter-spacing: .12em; font-weight: 850; }
.career-explorer-content .market-controls select { width: 100%; border: 1px solid #536176; background: #182941; color: white; border-radius: 7px; padding: 12px 38px 12px 13px; font-weight: 700; font-size: .86rem; }
.career-explorer-content .data-date { display: flex; align-items: center; gap: 10px; padding: 0 5px 10px 10px; white-space: nowrap; }
.career-explorer-content .data-date div { display: grid; }
.career-explorer-content .data-date b { font-size: .76rem; }
.career-explorer-content .data-date small { color: #95a4b5; font-size: .68rem; }
.career-explorer-content .data-dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 0 4px rgba(162,237,245,.16); }
.career-explorer-content .market-dashboard { background: white; border: 1px solid #d6ded9; border-top: 0; border-radius: 0 0 10px 10px; padding: clamp(24px, 4vw, 42px); box-shadow: 0 24px 55px rgba(16,24,40,.07); }
.career-explorer-content .market-result-head { display: flex; justify-content: space-between; gap: 32px; align-items: start; }
.career-explorer-content .market-result-head h3 { margin: 8px 0 5px; font-size: clamp(1.6rem, 3vw, 2.45rem); letter-spacing: -.04em; line-height: 1.08; }
.career-explorer-content .market-result-head p { margin: 0; color: var(--muted); font-size: .83rem; }
.career-explorer-content .market-signal { min-width: 190px; padding: 12px 14px; background: #eaf6fb; border-radius: 7px; display: grid; }
.career-explorer-content .market-signal span { color: var(--green-deep); font-size: .62rem; letter-spacing: .12em; font-weight: 900; }
.career-explorer-content .market-signal b { margin-top: 3px; font-size: .82rem; }
.career-explorer-content .metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin: 32px 0 20px; border: 1px solid var(--line); }
.career-explorer-content .metric-grid article { padding: 19px; border-right: 1px solid var(--line); }
.career-explorer-content .metric-grid article:last-child { border-right: 0; }
.career-explorer-content .metric-grid span, .career-explorer-content .card-title > div > span { display: block; color: #82908a; font-size: .61rem; font-weight: 900; letter-spacing: .11em; }
.career-explorer-content .metric-grid strong { display: block; margin: 7px 0 2px; font-size: clamp(1.45rem, 2.5vw, 2rem); letter-spacing: -.04em; line-height: 1; }
.career-explorer-content .metric-grid small { color: var(--muted); font-size: .67rem; }
.career-explorer-content .career-context-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 14px; margin-bottom: 14px; }
.career-explorer-content .outlook-card, .career-explorer-content .buying-power-card, .career-explorer-content .metro-card { border: 1px solid var(--line); border-radius: 8px; padding: 22px; }
.career-explorer-content .outlook-card h4, .career-explorer-content .buying-power-card h4 { margin: 6px 0 0; font-size: 1rem; }
.career-explorer-content .outlook-numbers { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 22px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.career-explorer-content .outlook-numbers > span { display: grid; padding: 16px 14px; border-right: 1px solid var(--line); }
.career-explorer-content .outlook-numbers > span:first-child { padding-left: 0; }
.career-explorer-content .outlook-numbers > span:last-child { border-right: 0; }
.career-explorer-content .outlook-numbers strong { font-size: 1.45rem; letter-spacing: -.035em; }
.career-explorer-content .outlook-numbers small { color: var(--muted); font-size: .66rem; }
.career-explorer-content .outlook-card > p, .career-explorer-content .buying-power-card > p { margin: 13px 0 0; color: var(--muted); font-size: .7rem; }
.career-explorer-content .buying-power-card { background: #eaf6fb; border-color: #c7dfeb; }
.career-explorer-content .buying-power-number { display: grid; margin: 20px 0 13px; }
.career-explorer-content .buying-power-number strong { font-size: 2.1rem; letter-spacing: -.05em; line-height: 1; }
.career-explorer-content .buying-power-number span { color: var(--muted); font-size: .69rem; }
.career-explorer-content .rpp-line { display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px solid #b9d9e5; font-size: .75rem; }
.career-explorer-content .market-detail-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 14px; }
.career-explorer-content .pay-card, .career-explorer-content .rank-card, .career-explorer-content .leaders-card, .career-explorer-content .resources-card { border: 1px solid var(--line); border-radius: 8px; padding: 22px; }
.career-explorer-content .card-title { display: flex; justify-content: space-between; align-items: start; gap: 16px; }
.career-explorer-content .card-title h4 { margin: 6px 0 0; font-size: 1rem; }
.career-explorer-content .card-title > small { color: var(--muted); font-size: .68rem; }
.career-explorer-content .wage-scale { padding-top: 38px; }
.career-explorer-content .wage-line { height: 6px; border-radius: 999px; background: #e4e9e6; position: relative; }
.career-explorer-content .wage-line > span { position: absolute; height: 100%; left: 18%; right: 18%; background: linear-gradient(90deg, var(--purple), var(--green)); border-radius: inherit; }
.career-explorer-content .wage-line i { position: absolute; left: 50%; top: 50%; width: 15px; height: 15px; border: 3px solid white; background: var(--navy); border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 0 1px var(--navy); }
.career-explorer-content .wage-labels { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 12px; }
.career-explorer-content .wage-labels span { display: grid; text-align: center; }
.career-explorer-content .wage-labels span:first-child { text-align: left; }
.career-explorer-content .wage-labels span:last-child { text-align: right; }
.career-explorer-content .wage-labels small { color: #89958f; font-size: .62rem; }
.career-explorer-content .wage-labels b { font-size: .74rem; }
.career-explorer-content .wage-labels .median b { color: var(--green-deep); }
.career-explorer-content .data-explainer { padding-top: 15px; border-top: 1px solid var(--line); color: var(--muted); font-size: .73rem; margin: 22px 0 0; }
.career-explorer-content .rank-card { display: flex; flex-direction: column; }
.career-explorer-content .compare-row { display: grid; grid-template-columns: 105px 1fr 55px; align-items: center; gap: 8px; margin-top: 24px; font-size: .74rem; }
.career-explorer-content .compare-row > div { height: 6px; background: #e4e9e6; border-radius: 999px; overflow: hidden; }
.career-explorer-content .compare-row i { display: block; width: 50%; height: 100%; background: var(--green-deep); border-radius: inherit; }
.career-explorer-content .compare-row b { text-align: right; }
.career-explorer-content .national-baseline { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; gap: 7px 14px; font-size: .74rem; }
.career-explorer-content .national-baseline span { color: var(--muted); }
.career-explorer-content .metro-card { margin-top: 14px; }
.career-explorer-content .metro-table { margin-top: 18px; border-top: 1px solid var(--line); }
.career-explorer-content .metro-row { display: grid; grid-template-columns: minmax(230px, 1.5fr) repeat(3, minmax(90px, .5fr)); gap: 14px; padding: 11px 5px; border-bottom: 1px solid var(--line); align-items: center; font-size: .77rem; }
.career-explorer-content .metro-row:not(.metro-header):hover { background: var(--paper); }
.career-explorer-content .metro-header { color: #84908a; font-size: .61rem; letter-spacing: .1em; font-weight: 900; text-transform: uppercase; }
.career-explorer-content .metro-row span:not(:first-child) { text-align: right; }
.career-explorer-content .metro-note { color: var(--muted); margin: 12px 0 0; font-size: .68rem; }
.career-explorer-content .metro-empty { color: var(--muted); padding: 20px 5px; font-size: .78rem; }
.career-explorer-content .market-lower-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 14px; margin-top: 14px; }
.career-explorer-content .leader-toggle { display: flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
.career-explorer-content .leader-toggle button { border: 0; background: white; padding: 6px 9px; color: var(--muted); font-size: .65rem; cursor: pointer; }
.career-explorer-content .leader-toggle button.active { background: var(--navy); color: white; }
.career-explorer-content .leaders-card ol { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 8px; }
.career-explorer-content .leaders-card li { display: grid; grid-template-columns: 22px 1fr auto; gap: 8px; align-items: center; font-size: .78rem; }
.career-explorer-content .leaders-card li span:first-child { color: var(--green-deep); font-weight: 900; }
.career-explorer-content .leaders-card li b { font-size: .72rem; }
.career-explorer-content .resources-card { background: #f4f1ff; border-color: #ddd5ff; }
.career-explorer-content .resources-card h4 { font-size: 1.2rem; margin: 8px 0; }
.career-explorer-content .resources-card > p { color: var(--muted); font-size: .82rem; max-width: 660px; }
.career-explorer-content .market-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
.career-explorer-content .market-links a { display: inline-flex; gap: 12px; border-bottom: 1px solid #8f85b5; padding: 5px 0; margin-right: 13px; font-size: .73rem; font-weight: 800; }
.career-explorer-content .market-links a span { color: var(--green-deep); }
.career-explorer-content .data-note { margin-top: 18px; display: grid; grid-template-columns: 120px 1fr; gap: 16px; color: var(--muted); font-size: .7rem; }
.career-explorer-content .data-note p { margin: 0; }
.career-explorer-content .market-dashboard.is-unavailable .metric-grid, .career-explorer-content .market-dashboard.is-unavailable .market-detail-grid { opacity: .35; pointer-events: none; }
.career-explorer-content .unavailable-note { margin: 24px 0 0; padding: 17px; border: 1px solid #efcf9d; background: #fff8eb; border-radius: 7px; color: #714c16; font-size: .82rem; }
.career-explorer-content .careers-view { margin-top: 0; }
.career-explorer-content .role-family-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #3a495e; border: 1px solid #3a495e; border-radius: 9px 9px 0 0; overflow: hidden; }
.career-explorer-content .role-family { border: 0; background: var(--navy); color: white; padding: 20px; min-height: 125px; display: flex; flex-direction: column; align-items: start; text-align: left; cursor: pointer; transition: background .18s; }
.career-explorer-content .role-family:hover { background: #1d3049; }
.career-explorer-content .role-family.active { background: var(--green); color: var(--ink); }
